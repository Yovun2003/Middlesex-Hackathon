# Server-only settings. Never use a VITE_ prefix for credentials.
NOU_DATABASE=sqlite
NOU_DATA_DIR=.noudilo
NOU_HOST=127.0.0.1
NOU_PORT=3000
NOU_SECURE_COOKIE=0

# Oracle mode: apply server/migrations first, then set NOU_DATABASE=oracle.
NOU_ORACLE_USER=
NOU_ORACLE_PASSWORD=
NOU_ORACLE_CONNECT_STRING=
NOU_ORACLE_WALLET_DIR=
NOU_ORACLE_WALLET_PASSWORD=
NOU_ORACLE_POOL_MAX=4

# Demo data is enabled only by npm run demo and uses .noudilo-demo.
# Demo accounts use Randnousdilo; quick role access is loopback-only in demo mode.
